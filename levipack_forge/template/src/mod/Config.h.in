#pragma once

#include <cstdint>
#include <string>
#include <string_view>

#include <pl/Config.hpp>

namespace @NS@ {

// Fields below `message` come from static Java fields found in the mod's bytecode.
struct ModConfig {
    int version = 1;
    bool enabled = true;
    std::string message = "Hello from @MODID@";
@CONFIG_FIELDS@
};

nlohmann::json makeDefaultConfigJson();
nlohmann::json makeConfigSchemaJson();

} // namespace @NS@

template <> struct pl::config::Schema<@NS@::ModConfig> {
    static constexpr std::string_view title = @TITLE@;
    static constexpr std::string_view description = {};

    static constexpr FieldSchema field(std::string_view name) {
        if (name == "version")
            return {.title = "Version", .readOnly = true};
        if (name == "enabled")
            return {.title = "Enabled", .description = "Turns @MODID@ behavior on or off."};
        if (name == "message")
            return {.title = "Message", .description = "Message written when the mod is enabled."};
@SCHEMA_FIELDS@
        return {};
    }
};
